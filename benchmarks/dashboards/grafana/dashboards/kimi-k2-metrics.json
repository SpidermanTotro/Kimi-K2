{
  "dashboard": {
    "title": "Kimi K2 Benchmark Metrics",
    "tags": ["kimi-k2", "benchmarks", "ai"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Model Accuracy Over Time",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "kimi_k2_accuracy",
            "legendFormat": "Accuracy",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "min": 0, "max": 100},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Pass Rate by Dataset",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "kimi_k2_pass_rate",
            "legendFormat": "Pass Rate",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "min": 0, "max": 100},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Inference Latency (P50, P95, P99)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "kimi_k2_latency_p50",
            "legendFormat": "P50",
            "refId": "A"
          },
          {
            "expr": "kimi_k2_latency_p95",
            "legendFormat": "P95",
            "refId": "B"
          },
          {
            "expr": "kimi_k2_latency_p99",
            "legendFormat": "P99",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"format": "ms"},
          {"format": "short"}
        ]
      },
      {
        "id": 4,
        "title": "Average Token Count",
        "type": "stat",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "kimi_k2_avg_tokens",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          }
        }
      },
      {
        "id": 5,
        "title": "Benchmark Status",
        "type": "table",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "kimi_k2_benchmark_status",
            "format": "table",
            "refId": "A"
          }
        ]
      }
    ],
    "refresh": "30s",
    "schemaVersion": 16,
    "version": 1,
    "time": {
      "from": "now-6h",
      "to": "now"
    }
  }
}
